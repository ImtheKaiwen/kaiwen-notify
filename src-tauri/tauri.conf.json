{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaiwen Notify",
  "version": "0.5.0",
  "identifier": "com.kaiwen.notify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaiwen Notify",
        "label": "main",
        "width": 680,
        "height": 760,
        "minWidth": 500,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Turkish",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "shortDescription": "Task completion sound notifier",
    "license": "LICENSE"
  }
}